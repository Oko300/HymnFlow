# HymnFlow — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub

# ── Gemini API Keys (comma-separated, one per Google account) ───────────────
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10

# ── Google Cloud TTS ─────────────────────────────────────────────────────────
# Path to your Google Cloud service account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=google_tts_credentials.json
TTS_VOICE_NAME=en-US-Wavenet-D
TTS_SPEAKING_RATE=0.85

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_personal_chat_id

# ── YouTube ──────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CREDENTIALS_FILE=youtube_token.json

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Scheduler ────────────────────────────────────────────────────────────────
# Hour and minute in UTC when daily hymn is generated (6:00 UTC = 7:00 WAT)
DAILY_GENERATION_HOUR=6
DAILY_GENERATION_MINUTE=0

# ── Web Dashboard ────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production
PORT=5000
